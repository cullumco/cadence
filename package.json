{
  "name": "@cullumco/cadence",
  "version": "0.2.0",
  "description": "Agents that read the room. Ambient context, cadence dials, and finish-line guardrails for Claude Code and any agent harness. Richest signals on macOS; universal signals (time, git, activity, intent, self-report) everywhere.",
  "type": "module",
  "bin": {
    "cadence": "bin/cadence"
  },
  "homepage": "https://cadence.cullum.co/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cullumco/cadence.git"
  },
  "bugs": {
    "url": "https://github.com/cullumco/cadence/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    ".claude-plugin",
    ".codex-plugin",
    "hooks",
    "skills",
    "dist",
    "bin",
    "README.md",
    "ALPHA.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "node --test test/cadence.test.js",
    "test:coverage": "c8 --include 'dist/**/*.js' --exclude 'dist/**/*.d.ts' --reporter=text --reporter=html node --test test/cadence.test.js",
    "prepack": "npm run build",
    "prepublishOnly": "node scripts/verify-alpha.mjs --no-install-smoke",
    "release:alpha": "node scripts/release-alpha.mjs",
    "verify:alpha": "node scripts/verify-alpha.mjs",
    "plugin:validate": "claude plugin validate .claude-plugin/plugin.json && claude plugin validate --strict .claude-plugin/marketplace.json",
    "hook": "node dist/hook.js",
    "cli": "node dist/cli.js"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "c8": "^10.1.3",
    "typescript": "^5.4.0"
  },
  "keywords": [
    "claude-code",
    "claude",
    "spotify",
    "context",
    "agent",
    "hook",
    "cadence",
    "context-engineering"
  ],
  "license": "MIT",
  "author": "Cullum&Co"
}
